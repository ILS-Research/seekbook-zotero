{
  "manifest_version": 2,
  "name": "SeekBook",
  "version": "0.0.0",
  "description": "Full-text index (semantic + keyword) for books in Zotero, served to other plugins over a local REST API.",
  "author": "ILS",
  "icons": {
    "48": "content/icons/seekbook.svg",
    "96": "content/icons/seekbook.svg"
  },
  "applications": {
    "zotero": {
      "id": "seekbook@ils-forschung.de",
      "update_url": "https://zotero.ils.local/downloads/seekbook/updates.json",
      "strict_min_version": "7.0",
      "strict_max_version": "10.0.*"
    }
  }
}
